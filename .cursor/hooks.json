{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "jq -n --arg c 'Apply /poteto-mode.' '{additional_context: $c}'"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "cat >/dev/null; jq -n --arg m 'Use /technical-writing, then /unslop.' '{permission:\"allow\",agent_message:$m}'",
        "matcher": "git\\s+commit"
      }
    ]
  }
}
