{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "An account with this email address already exists.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスのアカウントは既に存在します。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        }
      }
    },
    "Couldn't connect to the server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。"
          }
        }
      }
    },
    "Enter the code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを入力"
          }
        }
      }
    },
    "Enter your email address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスを入力"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー"
          }
        }
      }
    },
    "Get Started": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        }
      }
    },
    "No account was found for this email address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスのアカウントが見つかりません。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Rap with the world.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界とラップしよう。"
          }
        }
      }
    },
    "Resend code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを再送"
          }
        }
      }
    },
    "Send Code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを送信"
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。もう一度お試しください。"
          }
        }
      }
    },
    "The code has expired. Please request a new one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの有効期限が切れました。再送してください。"
          }
        }
      }
    },
    "The code is incorrect.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが正しくありません。"
          }
        }
      }
    },
    "The email address or code is invalid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはコードが正しくありません。"
          }
        }
      }
    },
    "This account has not been confirmed yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはまだ確認されていません。"
          }
        }
      }
    },
    "We couldn't send the code. Please try again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを送信できませんでした。しばらくしてから再度お試しください。"
          }
        }
      }
    },
    "We sent a 6-digit code to %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に 6 桁のコードを送信しました。"
          }
        }
      }
    },
    "We'll send you a 6-digit code to sign in or create an account.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインまたはアカウント作成用の 6 桁のコードを送信します。"
          }
        }
      }
    },
    "Your session has expired. Please sign in again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。もう一度サインインしてください。"
          }
        }
      }
    }
  }
}
