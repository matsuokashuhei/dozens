{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@dozens/api": "*",
    "@dozens/db": "*",
    "@dozens/env": "*",
    "@hono/node-server": "^2.0.12",
    "@orpc/openapi": "^1.14.12",
    "@orpc/server": "^1.14.12",
    "@orpc/zod": "^1.14.12",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dozens/config": "*",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
